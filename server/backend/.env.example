# VideoMind Server 环境变量示例
# 复制为 .env 并填入你自己的值；不要提交 .env

# ---- 上游模型服务（必填）----
# 任何兼容的 OpenAI / Gemini 原生视频路由端点都可以，由你决定用哪家。
# 原生视频理解走 {base}/antigravity/v1beta/models/{model}:generateContent，
# 文本/抽帧兼容走 {base}/v1/chat/completions。
#
# ⚠️ 模型必须支持原生视频理解（视频 + 音频直接输入），推荐使用 Gemini 系列。
#    纯文本模型或不支持视频输入的模型无法完成理解任务。
#    默认值 gemini-3.6-flash-high 按 Gemini 原生视频路由实现。
#
# 方式 A（推荐用于生产）：官方 API
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com
# 方式 B：作者自营中转站 https://1127666.xyz（推广性质，非中立推荐；
#   你的视频内容与密钥会经过该中转站，敏感数据请改用方式 A）
#   OPENAI_BASE_URL=https://1127666.xyz
OPENAI_BASE_URL=https://your-upstream-endpoint
OPENAI_API_KEY=your-upstream-api-key
DEFAULT_MODEL=gemini-3.6-flash-high

# ---- 安全（生产必填）----
# 用于 JWT 与验证码签名，请用足够长的随机串，例如：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=production

# ---- 管理员 ----
# 该邮箱登录后自动获得管理员角色，可访问后台管理页；留空则关闭管理后台
ADMIN_EMAIL=

# ---- 邮箱验证码（生产必填，用于注册/登录/找回密码）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=VideoMind

# ---- 存储与并发（可选，默认值通常够用）----
# DATABASE_URL=sqlite:///./jobs_data/app.sqlite3
# JOBS_DIR=./jobs_data
# UPLOADS_DIR=./uploads_data
# WORKER_COUNT=2
# MAX_VIDEO_DURATION_SEC=14400
# CORS_ORIGINS=https://your-domain.com
